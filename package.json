{
  "name": "@vauxr/openclaw",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:contract": "npm run build && node --test test/real-contract.test.mjs"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.3",
      "minGatewayVersion": "2026.9.3"
    },
    "build": {
      "openclawVersion": "2026.9.3",
      "pluginSdkVersion": "2026.9.3"
    }
  },
  "dependencies": {
    "@sinclair/typebox": "^0.32.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "openclaw": "2026.9.3",
    "typescript": "^5.0.0"
  },
  "description": "An OpenClaw plugin that gives your agents the ability to speak through and control Vauxr voice assistant devices.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vauxr-ai/vauxr-openclaw.git"
  }
